# Database — utiliser la connection string Supabase (Settings → Database)
# Pas de Postgres local / Docker.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
# Production : WEB_URL=https://rc-consulting-legal.com
AUTH_SECRET=change-me-to-a-long-random-secret

# Auth seed
ADMIN_EMAIL=admin@rc-consulting-legal.com
ADMIN_PASSWORD=Admin123!

# Resend — emails transactionnels (Edge Function + script de test)
RESEND_API_KEY=
EMAIL_FROM="RC Consulting <noreply@rc-consulting-legal.com>"
EMAIL_REPLY_TO=contact@rc-consulting-legal.com
ADMIN_NOTIFY_EMAIL=contact@rc-consulting-legal.com,charlotte.richard@rc-consulting-legal.com
TEST_TO=

# Cloudinary (optional — local placeholder URLs if missing)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact
CONTACT_PHONE=+32476950655
CONTACT_EMAIL=contact@rc-consulting-legal.com
CONTACT_WHATSAPP=32476950655
CONTACT_ADDRESS="Belgique · République démocratique du Congo"
GOOGLE_MAPS_EMBED_URL="https://maps.google.com/maps?q=Bruxelles%20Belgique&t=&z=12&ie=UTF8&iwloc=&output=embed"
