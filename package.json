{
  "name": "rc-consulting",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c gold,cyan \"npm run dev -w @rc/api\" \"npm run dev -w @rc/web\"",
    "dev:web": "npm run dev -w @rc/web",
    "dev:api": "npm run dev -w @rc/api",
    "build": "npm run build -w @rc/shared && npm run build -w @rc/api && npm run build -w @rc/web",
    "db:generate": "npm run db:generate -w @rc/api",
    "db:migrate": "npm run db:migrate -w @rc/api",
    "db:seed": "npm run db:seed -w @rc/api",
    "db:push": "npm run db:push -w @rc/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
